FROM python:3.11-slim

WORKDIR /app

# System deps needed by xgboost's shared library
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY api/ ./api/
COPY data/ ./data/
# `docker compose run --rm api python -m src.train --tracking-uri http://mlflow:5000`
# reuses this same image to train + register a model before the API starts serving.

# mlflow.db and the model registry are mounted in via docker-compose, not
# baked into the image - the image is code, the data is state.
ENV MLFLOW_TRACKING_URI=sqlite:///mlflow.db
ENV MODEL_ALIAS=champion

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
